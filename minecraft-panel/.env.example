# ─────────────────────────────────────────────────────────────────────────────
# gkku Panel — Environment Variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# Server port (default: 3000)
PORT=3000

# Strong random string for signing session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_string

# Public URL of the panel (used in password-reset email links)
APP_URL=http://localhost:3000

# ── SMTP (optional — needed only for password-reset emails) ─────────────────
# Leave these blank to disable email; the panel will show the reset token on
# screen instead (development / LAN-only mode).

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=gkku Panel <noreply@example.com>
