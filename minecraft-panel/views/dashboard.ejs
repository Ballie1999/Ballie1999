<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard — MC Panel</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <nav>
    <div class="nav-brand">⛏ MC Panel</div>
    <div class="nav-links">
      <a href="/">Dashboard</a>
      <a href="/logout">Logout (<%= username %>)</a>
    </div>
  </nav>
  <main>
    <div class="page-header">
      <h2>Minecraft Accounts</h2>
      <a href="/accounts/add" class="btn btn-primary">+ Add Account</a>
    </div>

    <% if (accounts.length === 0) { %>
      <div class="empty-state">
        <p>No accounts yet. Click <strong>+ Add Account</strong> to get started.</p>
      </div>
    <% } else { %>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Username</th>
              <th>Email</th>
              <th>Proxy</th>
              <th>Status</th>
              <th>Notes</th>
              <th>Added</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% accounts.forEach((acc, i) => { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><strong><%= acc.username %></strong></td>
                <td><%= acc.email || '—' %></td>
                <td>
                  <% if (acc.proxy_host) { %>
                    <code><%= acc.proxy_host %>:<%= acc.proxy_port %></code>
                    <% if (acc.proxy_user) { %><span class="badge">auth</span><% } %>
                  <% } else { %>
                    <span class="muted">None</span>
                  <% } %>
                </td>
                <td>
                  <span class="status-badge status-<%= acc.status %>"><%= acc.status %></span>
                </td>
                <td><%= acc.notes || '—' %></td>
                <td class="muted"><%= new Date(acc.created_at).toLocaleDateString() %></td>
                <td class="actions">
                  <a href="/accounts/edit/<%= acc.id %>" class="btn btn-sm btn-secondary">Edit</a>
                  <form method="POST" action="/accounts/delete/<%= acc.id %>" style="display:inline"
                        onsubmit="return confirm('Delete <%= acc.username %>?')">
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</body>
</html>
