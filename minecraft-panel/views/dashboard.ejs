<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard — gkku</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body class="dashboard-page">
  <% const RAM_PER_BOT_GB = 0.45; %>
  <% const onlineCount = accounts.filter((acc) => acc.status === 'active').length; %>
  <% const queueCount = accounts.filter((acc) => acc.status === 'inactive').length; %>
  <% const ramUsage = (accounts.length * RAM_PER_BOT_GB).toFixed(1); %>

  <div class="app-shell">
    <aside class="sidebar">
      <div class="sidebar-brand">gkku</div>
      <div class="sidebar-label">Control</div>
      <nav class="sidebar-menu">
        <a href="/" class="active">Dashboard</a>
        <a href="/accounts/add">Add Account</a>
        <a href="/logout">Logout</a>
      </nav>
      <div class="sidebar-user">Signed in as <strong><%= username %></strong></div>
    </aside>

    <main class="main-content">
      <header class="main-header">
        <div>
          <p class="section-label">Overview</p>
          <h1>Bot Dashboard</h1>
        </div>
        <a href="/accounts/add" class="btn btn-primary">+ Add Account</a>
      </header>

      <section class="stats-row">
        <article class="stats-card">
          <p class="section-label">Bots</p>
          <h3><%= accounts.length %></h3>
        </article>
        <article class="stats-card">
          <p class="section-label">Online</p>
          <h3><%= onlineCount %></h3>
        </article>
        <article class="stats-card">
          <p class="section-label">In Queue</p>
          <h3><%= queueCount %></h3>
        </article>
        <article class="stats-card">
          <p class="section-label">RAM</p>
          <h3><%= ramUsage %> GB</h3>
        </article>
      </section>

      <section class="search-row">
        <input type="text" class="search-input" placeholder="Search bot cards..." aria-label="Search accounts" />
        <div class="search-actions">
          <a href="/" class="btn btn-secondary btn-sm">Refresh</a>
          <a href="/accounts/add" class="btn btn-primary btn-sm">New</a>
        </div>
      </section>

      <% if (accounts.length === 0) { %>
        <div class="empty-state">
          <p>No accounts yet. Click <strong>+ Add Account</strong> to get started.</p>
        </div>
      <% } else { %>
        <section class="bot-grid">
          <% accounts.forEach((acc) => { %>
            <article class="bot-card">
              <div class="bot-card-head">
                <div>
                  <p class="section-label">Username</p>
                  <h3><%= acc.username %></h3>
                </div>
                <span class="status-pill status-<%= acc.status %>"><%= acc.status %></span>
              </div>

              <div class="bot-card-body">
                <div class="bot-row">
                  <span class="section-label">Proxy</span>
                  <% if (acc.proxy_host) { %>
                    <code><%= acc.proxy_host %>:<%= acc.proxy_port %></code>
                  <% } else { %>
                    <span class="muted">None</span>
                  <% } %>
                </div>

                <div class="bot-row">
                  <span class="section-label">Notes</span>
                  <span><%= acc.notes || '—' %></span>
                </div>

                <div class="bot-row">
                  <span class="section-label">Added</span>
                  <span class="muted"><%= new Date(acc.created_at).toLocaleDateString() %></span>
                </div>
              </div>

              <div class="bot-actions">
                <a href="/accounts/edit/<%= acc.id %>" class="btn btn-sm btn-secondary">Edit</a>
                <form method="POST" action="/accounts/delete/<%= acc.id %>" onsubmit="return confirm('Delete <%= acc.username %>?')">
                  <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
              </div>
            </article>
          <% }) %>
        </section>
      <% } %>
    </main>
  </div>
</body>
</html>
