<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Account — gkku</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <nav>
    <div class="nav-brand">gkku</div>
    <div class="nav-links">
      <a href="/">Dashboard</a>
      <a href="/logout">Logout (<%= username %>)</a>
    </div>
  </nav>
  <main>
    <div class="page-header">
      <h2>Edit Account: <%= account.username %></h2>
      <a href="/" class="btn btn-secondary">← Back</a>
    </div>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="form-card">
      <form method="POST" action="/accounts/edit/<%= account.id %>">

        <h3>Account Details</h3>
        <div class="form-row">
          <div class="form-group">
            <label for="mc_username">Minecraft Username <span class="required">*</span></label>
            <input type="text" id="mc_username" name="mc_username" value="<%= account.username %>" required />
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= account.email %>" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="password">Account Password</label>
            <input type="password" id="password" name="password" value="<%= account.password %>" />
          </div>
          <div class="form-group">
            <label for="status">Status</label>
            <select id="status" name="status">
              <option value="unknown"  <%= account.status === 'unknown'  ? 'selected' : '' %>>Unknown</option>
              <option value="active"   <%= account.status === 'active'   ? 'selected' : '' %>>Active</option>
              <option value="inactive" <%= account.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
              <option value="banned"   <%= account.status === 'banned'   ? 'selected' : '' %>>Banned</option>
            </select>
          </div>
        </div>

        <h3>Proxy Settings</h3>
        <div class="form-row">
          <div class="form-group">
            <label for="proxy_host">Proxy Host</label>
            <input type="text" id="proxy_host" name="proxy_host" value="<%= account.proxy_host %>" />
          </div>
          <div class="form-group">
            <label for="proxy_port">Proxy Port</label>
            <input type="text" id="proxy_port" name="proxy_port" value="<%= account.proxy_port %>" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="proxy_user">Proxy Username</label>
            <input type="text" id="proxy_user" name="proxy_user" value="<%= account.proxy_user %>" />
          </div>
          <div class="form-group">
            <label for="proxy_pass">Proxy Password</label>
            <input type="text" id="proxy_pass" name="proxy_pass" value="<%= account.proxy_pass %>" />
          </div>
        </div>

        <div class="form-group">
          <label for="notes">Notes</label>
          <textarea id="notes" name="notes" rows="3"><%= account.notes %></textarea>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Update Account</button>
          <a href="/" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </main>
</body>
</html>
