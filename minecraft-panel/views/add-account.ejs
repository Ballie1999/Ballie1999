<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add Account — MC Panel</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <nav>
    <div class="nav-brand">⛏ MC Panel</div>
    <div class="nav-links">
      <a href="/">Dashboard</a>
      <a href="/logout">Logout (<%= username %>)</a>
    </div>
  </nav>
  <main>
    <div class="page-header">
      <h2>Add Minecraft Account</h2>
      <a href="/" class="btn btn-secondary">← Back</a>
    </div>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="form-card">
      <form method="POST" action="/accounts/add">

        <h3>Account Details</h3>
        <div class="form-row">
          <div class="form-group">
            <label for="mc_username">Minecraft Username <span class="required">*</span></label>
            <input type="text" id="mc_username" name="mc_username" placeholder="Steve" required />
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="steve@example.com" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="password">Account Password</label>
            <input type="text" id="password" name="password" placeholder="Account password" />
          </div>
          <div class="form-group">
            <label for="status">Status</label>
            <select id="status" name="status">
              <option value="unknown">Unknown</option>
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
              <option value="banned">Banned</option>
            </select>
          </div>
        </div>

        <h3>Proxy Settings</h3>
        <div class="form-row">
          <div class="form-group">
            <label for="proxy_host">Proxy Host</label>
            <input type="text" id="proxy_host" name="proxy_host" placeholder="192.168.1.1" />
          </div>
          <div class="form-group">
            <label for="proxy_port">Proxy Port</label>
            <input type="text" id="proxy_port" name="proxy_port" placeholder="8080" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="proxy_user">Proxy Username</label>
            <input type="text" id="proxy_user" name="proxy_user" placeholder="Optional" />
          </div>
          <div class="form-group">
            <label for="proxy_pass">Proxy Password</label>
            <input type="text" id="proxy_pass" name="proxy_pass" placeholder="Optional" />
          </div>
        </div>

        <div class="form-group">
          <label for="notes">Notes</label>
          <textarea id="notes" name="notes" rows="3" placeholder="Any extra info about this account..."></textarea>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Save Account</button>
          <a href="/" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </main>
</body>
</html>
